{
  "table": "RESULT",
  "area": "clinical",
  "description": "Test results, one row per result field, with the normal range and flag at the time.",
  "primaryKey": [
    "RESULT_ID"
  ],
  "columns": [
    {
      "name": "RESULT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "primaryKey": true
    },
    {
      "name": "LINE_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "ORDERLINE.LINE_ID"
    },
    {
      "name": "VISIT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "VISIT.VISIT_ID"
    },
    {
      "name": "PET_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "PET.PET_ID"
    },
    {
      "name": "FIELD_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "TESTFIELD.FIELD_ID"
    },
    {
      "name": "FIELD_NAME",
      "type": "nvarchar",
      "size": 60,
      "nullable": false
    },
    {
      "name": "VALUE_NUM",
      "type": "decimal",
      "precision": 12,
      "scale": 3,
      "nullable": true
    },
    {
      "name": "VALUE_TEXT",
      "type": "nvarchar",
      "size": 400,
      "nullable": false,
      "default": ""
    },
    {
      "name": "UNIT",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "default": ""
    },
    {
      "name": "LOW_VALUE",
      "type": "decimal",
      "precision": 12,
      "scale": 3,
      "nullable": true
    },
    {
      "name": "HIGH_VALUE",
      "type": "decimal",
      "precision": 12,
      "scale": 3,
      "nullable": true
    },
    {
      "name": "FLAG",
      "type": "nvarchar",
      "size": 2,
      "nullable": false,
      "default": "",
      "values": [
        "",
        "H",
        "L"
      ],
      "description": "H = above, L = below the normal range."
    },
    {
      "name": "ENTERED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID"
    },
    {
      "name": "ENTERED_UTC",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "SYSDTE",
      "type": "datetime",
      "nullable": false,
      "default": "GETDATE()"
    }
  ],
  "indexes": [
    {
      "name": "IX_RESULT_LINE",
      "unique": false,
      "columns": [
        "LINE_ID"
      ]
    },
    {
      "name": "IX_RESULT_PET",
      "unique": false,
      "columns": [
        "PET_ID",
        "FIELD_ID",
        "ENTERED_UTC"
      ]
    }
  ],
  "referencedBy": []
}
