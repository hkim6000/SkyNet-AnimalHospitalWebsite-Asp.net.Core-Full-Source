{
  "table": "VISIT",
  "area": "clinical",
  "description": "A visit or boarding stay in the hospital, from check-in to closed.",
  "primaryKey": [
    "VISIT_ID"
  ],
  "columns": [
    {
      "name": "VISIT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "primaryKey": true
    },
    {
      "name": "VISIT_NO",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "description": "Visit number, e.g. V2026-01364 (restarts each year)."
    },
    {
      "name": "APPT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "APPOINTMENT.APPT_ID"
    },
    {
      "name": "CLIENT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "CLIENT.CLIENT_ID"
    },
    {
      "name": "PET_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "PET.PET_ID"
    },
    {
      "name": "VISIT_TYPE",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "default": "clinic",
      "values": [
        "clinic",
        "grooming",
        "surgery",
        "boarding"
      ]
    },
    {
      "name": "STATUS",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "default": "waiting",
      "values": [
        "waiting",
        "inroom",
        "checkout",
        "closed",
        "cancelled"
      ]
    },
    {
      "name": "STAFF_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID",
      "description": "Who sees the patient."
    },
    {
      "name": "REASON",
      "type": "nvarchar",
      "size": 300,
      "nullable": false,
      "default": ""
    },
    {
      "name": "CHECKIN_AT",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "START_AT",
      "type": "datetime2",
      "nullable": true
    },
    {
      "name": "READY_AT",
      "type": "datetime2",
      "nullable": true
    },
    {
      "name": "CLOSED_AT",
      "type": "datetime2",
      "nullable": true
    },
    {
      "name": "PLAN_OUT",
      "type": "datetime2",
      "nullable": true,
      "description": "Boarding: planned check-out."
    },
    {
      "name": "RECHECK_DATE",
      "type": "date",
      "nullable": true,
      "description": "Recheck date for the owner."
    },
    {
      "name": "SUMMARY",
      "type": "nvarchar",
      "size": 2000,
      "nullable": false,
      "default": "",
      "description": "Take-home summary for the owner."
    },
    {
      "name": "CREATED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID",
      "description": "STAFF_ID, or web."
    },
    {
      "name": "SYSDTE",
      "type": "datetime",
      "nullable": false,
      "default": "GETDATE()"
    }
  ],
  "indexes": [
    {
      "name": "UX_VISIT_NO",
      "unique": true,
      "columns": [
        "VISIT_NO"
      ]
    },
    {
      "name": "IX_VISIT_PET",
      "unique": false,
      "columns": [
        "PET_ID",
        "CHECKIN_AT"
      ]
    },
    {
      "name": "IX_VISIT_STATUS",
      "unique": false,
      "columns": [
        "STATUS",
        "CHECKIN_AT"
      ]
    }
  ],
  "referencedBy": [
    "APPOINTMENT.VISIT_ID",
    "DIAGNOSIS.VISIT_ID",
    "INVOICE.VISIT_ID",
    "MAILLOG.VISIT_ID",
    "ORDERLINE.VISIT_ID",
    "PETVACCINE.VISIT_ID",
    "PETWEIGHT.VISIT_ID",
    "RESULT.VISIT_ID",
    "VISITFILE.VISIT_ID",
    "VISITNOTE.VISIT_ID",
    "VISITROOM.VISIT_ID"
  ]
}
