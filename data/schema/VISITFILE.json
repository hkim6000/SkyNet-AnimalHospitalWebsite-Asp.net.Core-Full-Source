{
  "table": "VISITFILE",
  "area": "clinical",
  "description": "Files added to a visit (stored in the vault folder).",
  "primaryKey": [
    "FILE_ID"
  ],
  "columns": [
    {
      "name": "FILE_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "primaryKey": true
    },
    {
      "name": "VISIT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "VISIT.VISIT_ID"
    },
    {
      "name": "PET_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "PET.PET_ID"
    },
    {
      "name": "LINE_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "ORDERLINE.LINE_ID"
    },
    {
      "name": "TITLE",
      "type": "nvarchar",
      "size": 120,
      "nullable": false,
      "default": ""
    },
    {
      "name": "FILE_NAME",
      "type": "nvarchar",
      "size": 200,
      "nullable": false
    },
    {
      "name": "STORED_NAME",
      "type": "nvarchar",
      "size": 100,
      "nullable": false,
      "description": "File name inside the vault folder."
    },
    {
      "name": "MIME",
      "type": "nvarchar",
      "size": 60,
      "nullable": false
    },
    {
      "name": "BYTES",
      "type": "bigint",
      "nullable": false,
      "default": 0
    },
    {
      "name": "UPLOADED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID"
    },
    {
      "name": "UPLOADED_UTC",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "SEND_OWNER",
      "type": "bit",
      "nullable": false,
      "default": 1,
      "description": "1 = attached to the owner email."
    },
    {
      "name": "SYSDTE",
      "type": "datetime",
      "nullable": false,
      "default": "GETDATE()"
    }
  ],
  "indexes": [
    {
      "name": "IX_VISITFILE_VISIT",
      "unique": false,
      "columns": [
        "VISIT_ID"
      ]
    }
  ],
  "referencedBy": []
}
