      "size": "max",
      "nullable": false,
      "default": "[]",
      "description": "JSON array of content blocks."
    },
    {
      "name": "SAVED_UTC",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "SAVED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
