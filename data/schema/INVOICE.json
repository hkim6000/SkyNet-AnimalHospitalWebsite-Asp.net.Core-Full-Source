{
  "table": "INVOICE",
  "area": "money",
  "description": "One invoice per visit, with totals, payments and balance.",
  "primaryKey": [
    "INVOICE_ID"
  ],
  "columns": [
    {
      "name": "INVOICE_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "primaryKey": true
    },
    {
      "name": "INVOICE_NO",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "description": "Invoice number, e.g. INV2026-00001 (restarts each year)."
    },
    {
      "name": "VISIT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "VISIT.VISIT_ID"
    },
    {
      "name": "CLIENT_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "references": "CLIENT.CLIENT_ID"
    },
    {
      "name": "STATUS",
      "type": "nvarchar",
      "size": 20,
      "nullable": false,
      "default": "open",
      "values": [
        "open",
        "paid",
        "partial",
        "billed",
        "void"
      ]
    },
    {
      "name": "SUBTOTAL",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    {
      "name": "DISCOUNT",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0,
      "description": "Discount amount."
    },
    {
      "name": "DISCOUNT_NOTE",
      "type": "nvarchar",
      "size": 120,
      "nullable": false,
      "default": ""
    },
    {
      "name": "TAX",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    {
      "name": "TOTAL",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    {
      "name": "PAID",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0
    },
    {
      "name": "BALANCE",
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "nullable": false,
      "default": 0,
      "description": "TOTAL minus PAID."
    },
    {
      "name": "DUE_DATE",
      "type": "date",
      "nullable": true,
      "description": "Due date when billed to pay later."
    },
    {
      "name": "BILLED_UTC",
      "type": "datetime2",
      "nullable": true,
      "description": "When it was billed to pay later."
    },
    {
      "name": "CLOSED_UTC",
      "type": "datetime2",
      "nullable": true,
      "description": "When it was fully paid or voided."
    },
    {
      "name": "VOID_REASON",
      "type": "nvarchar",
      "size": 200,
      "nullable": false,
      "default": ""
    },
    {
      "name": "NOTE",
      "type": "nvarchar",
      "size": 600,
      "nullable": false,
      "default": ""
    },
    {
      "name": "CREATED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID"
    },
    {
      "name": "CREATED_UTC",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "SYSDTE",
      "type": "datetime",
      "nullable": false,
      "default": "GETDATE()"
    }
  ],
  "indexes": [
    {
      "name": "UX_INVOICE_NO",
      "unique": true,
      "columns": [
        "INVOICE_NO"
      ]
    },
    {
      "name": "IX_INVOICE_CLIENT",
      "unique": false,
      "columns": [
        "CLIENT_ID",
        "STATUS"
      ]
    },
    {
      "name": "IX_INVOICE_VISIT",
      "unique": false,
      "columns": [
        "VISIT_ID"
      ]
    }
  ],
  "referencedBy": [
    "INVOICELINE.INVOICE_ID",
    "MAILLOG.INVOICE_ID",
    "PAYMENT.INVOICE_ID"
  ]
}
