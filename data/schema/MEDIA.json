    },
    {
      "name": "PAGES",
      "type": "int",
      "nullable": false,
      "default": 0,
      "description": "PDF page count."
    },
    {
      "name": "WIDTH",
      "type": "int",
      "nullable": false,
      "default": 0
    },
    {
      "name": "HEIGHT",
      "type": "int",
      "nullable": false,
      "default": 0
    },
    {
      "name": "BYTES",
      "type": "bigint",
      "nullable": false,
      "default": 0
    },
    {
      "name": "ADDED_BY",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "default": "",
      "references": "STAFF.STAFF_ID"
    },
    {
      "name": "ADDED_UTC",
      "type": "datetime2",
      "nullable": false
    },
    {
      "name": "SYSDTE",
      "type": "datetime",
      "nullable": false,
      "default": "GETDATE()"
    }
  ],
  "indexes": [
    {
      "name": "UX_MEDIA_PATH",
