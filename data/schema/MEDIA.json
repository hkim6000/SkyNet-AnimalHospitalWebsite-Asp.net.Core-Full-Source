{
  "table": "MEDIA",
  "area": "website",
  "description": "Media library: photos, videos and PDFs.",
  "primaryKey": [
    "MEDIA_ID"
  ],
  "columns": [
    {
      "name": "MEDIA_ID",
      "type": "nvarchar",
      "size": 50,
      "nullable": false,
      "primaryKey": true
    },
    {
      "name": "KIND",
      "type": "nvarchar",
      "size": 10,
      "nullable": false,
      "default": "photo",
      "values": [
        "photo",
        "video",
        "doc"
      ]
    },
    {
      "name": "TITLE",
      "type": "nvarchar",
      "size": 120,
      "nullable": false,
      "default": ""
    },
    {
      "name": "ALT",
      "type": "nvarchar",
      "size": 200,
      "nullable": false,
      "default": ""
    },
    {
      "name": "TAGS",
      "type": "nvarchar",
      "size": 200,
      "nullable": false,
      "default": ""
    },
    {
      "name": "FULL_PATH",
      "type": "nvarchar",
      "size": 300,
      "nullable": false,
      "description": "Web path of the file under images/."
    },
    {
      "name": "THUMB_PATH",
      "type": "nvarchar",
      "size": 300,
      "nullable": false,
      "default": "",
