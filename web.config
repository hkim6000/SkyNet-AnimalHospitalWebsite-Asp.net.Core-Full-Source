<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AnimalHospital.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <directoryBrowse enabled="false" />
      <security>
        <requestFiltering>
          <hiddenSegments>
            <add segment="appConfig" />
            <add segment="codes" />
            <add segment="data" />
            <add segment="htmls" />
            <add segment="logs" />
            <add segment="temp" />
            <add segment="vault" />
          </hiddenSegments>
          <fileExtensions allowUnlisted="true">
            <add fileExtension=".json" allowed="false" />
            <add fileExtension=".dll" allowed="false" />
            <add fileExtension=".exe" allowed="false" />
            <add fileExtension=".pdb" allowed="false" />
            <add fileExtension=".cfg" allowed="false" />
            <add fileExtension=".sql" allowed="false" />
            <add fileExtension=".md" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
